# Copy this file to .env and fill in the values. Never share the real values.

# Required
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
GEMINI_API_KEY=

# Optional: free voice notes (get a key at console.groq.com)
GROQ_API_KEY=

# Optional: only if a free host puts the bot to sleep. Your host's public address, e.g. https://jarvis.onrender.com
WEBHOOK_URL=

# Optional: change only if Google retires the default model
GEMINI_MODEL=
